(globalThis.TURBOPACK||(globalThis.TURBOPACK=[])).push(["object"==typeof document?document.currentScript:void 0,41225,e=>{"use strict";e.s(["SAMPLE_PRO_DATA",0,{url:"https://example-agency.com",score:84,executive_summary:"This site reads as heavily AI-generated, scoring 84/100. The hero opener \"In today's fast-paced digital landscape\" is the single most common AI tell on the web, and not one section contains a verifiable fact, name or price. That costs you twice: Google's Helpful Content system suppresses exactly this kind of copy, and visitors who smell template text do not call. The highest-impact fix is rewriting the hero and about sections with the real numbers your business already has - both rewrites are provided below, ready to paste.",seo_meta:{current_title:"Home - Solutions for Your Business",improved_title:"Web Design for Dental Practices in Austin | Example Agency",current_description:"",improved_description:"We build websites for dental practices. 212 projects since 2014, bookings up 40% on average. Fixed pricing from $2,500, live in 3 weeks."},heatmap:[{section:"Hero",score:94,excerpt:"In today's fast-paced digital landscape, we empower businesses to seamlessly transform..."},{section:"About Us",score:88,excerpt:"Our dedicated team leverages cutting-edge solutions to drive meaningful impact for clients..."},{section:"Call to Action",score:83,excerpt:"Feel free to reach out and unlock your business's full potential today..."},{section:"Services",score:76,excerpt:"Whether you're a startup or an enterprise, our robust platform streamlines your workflow..."},{section:"Testimonials",score:71,excerpt:"Sarah M. - This transformed my workflow! I couldn't imagine going back..."},{section:"Footer",score:42,excerpt:"© 2025 Example Agency. All rights reserved. Privacy Policy. Terms of Service."}],rewrites:[{original:"In today's fast-paced digital landscape, we empower your business with seamless, cutting-edge solutions tailored to your unique needs.",why_ai:'4 stacked AI buzzwords ("fast-paced digital landscape", "empower", "seamless", "cutting-edge") in one sentence. This exact opener pattern appears on 30,000+ AI-generated sites.',human_version:"We spent six years inside marketing agencies watching clients pay for copy that sounded like everyone else's. So we started a studio that does one thing: web copy with actual facts in it."},{original:"Our comprehensive suite of services is designed to elevate your brand and streamline your journey to success.",why_ai:'Zero concrete information - no service names, no prices, no outcomes. "Comprehensive suite", "elevate" and "journey to success" are interchangeable filler.',human_version:"We do three things: brand strategy ($4k, 3 weeks), website copy ($2.5k, 2 weeks), and monthly content (from $900). Pick one or stack them."},{original:"With 10+ years of experience and 500+ satisfied clients, we are a testament to excellence in the industry.",why_ai:'Fake round numbers with no proof, plus the classic "a testament to" tell. No client names, no case studies, no verifiable claims.',human_version:"Since 2014 we've shipped 212 projects. The three we're proudest of: rebranding Hartley Dental (bookings +40%), the Fieldnote app launch, and Marsh & Co's full site rewrite."}],improvement_prompts:[{section:"Hero",prompt:'Rewrite this hero copy: "In today\'s fast-paced digital landscape, we empower your business with seamless, cutting-edge solutions tailored to your unique needs."\n\nRules: max 20 words, mention what the company actually sells (web design for dental practices), include one concrete number, banned words: empower, seamless, cutting-edge, landscape, solutions.'},{section:"About Us",prompt:"Rewrite our about section in first person plural, conversational tone. Include: founding year (2014), team size (6), one real client story with a named business and a measurable result. Max 80 words. No buzzwords."}],seo_tips:[{tip:'Title tag is "Home - Solutions for Your Business" - generic, matches no search query',priority:"critical",action:'Change to "Web Design for Dental Practices | [City] - Example Agency" to match what buyers actually search.'},{tip:"AI-pattern density (84%) puts the site at risk under Google's Helpful Content system",priority:"critical",action:"Rewrite the hero and about sections first (see rewrites above) - these two carry the highest AI density."},{tip:"No author bylines or E-E-A-T signals anywhere on the site",priority:"high",action:"Add a real team page with names, photos and LinkedIn links; byline all blog posts."},{tip:"Zero internal blog/resource content - no long-tail keyword coverage",priority:"high",action:'Publish 3 posts targeting "[service] for [niche]" queries your clients actually google.'}],brand_voice:{current_tone:"Generic SaaS-marketing enthusiasm - vague, upbeat, interchangeable with any competitor.",recommended_tone:"Direct and specific: real numbers, named clients, plain sentences. Confidence through facts, not adjectives.",dos:["Name the niche in the first sentence","Use real prices and timelines","Quote real clients with full names"],donts:['Never open with "In today\'s..."',"Ban: leverage, seamless, empower, elevate",'No round fake numbers ("500+ clients")']},action_plan:[{step:1,title:"Rewrite the hero section",description:"Highest AI density (94%) and the first thing visitors see. Use the rewrite provided above.",effort:"medium"},{step:2,title:"Fix the title tag",description:"Two-minute change, direct ranking impact. Exact replacement provided in SEO section.",effort:"low"},{step:3,title:"Add a real team page",description:"Names + photos + LinkedIn. Core E-E-A-T signal Google looks for.",effort:"low"},{step:4,title:"Replace fake testimonials",description:'Swap "Sarah M." style quotes for 3 real clients with full names and companies.',effort:"medium"}],ux_tips:[{issue:'CTA button says "Unlock Your Potential"',impact:"Vague CTAs convert ~3x worse than specific next steps.",fix:'Change to "Book a 20-min intro call" or "See pricing".'},{issue:"No pricing anywhere on the site",impact:"Hidden pricing loses roughly two-thirds of B2B visitors before contact.",fix:'Add a "Projects start at $2,500" line under the services section.'}],content_gaps:[{gap:"No case studies",why_it_matters:"The single highest-converting B2B content type - and proof your testimonials are real.",what_to_write:'"How Hartley Dental got 40% more bookings after the redesign" - problem, what you did, measurable result.'},{gap:"No FAQ section",why_it_matters:"FAQ content ranks in Google featured snippets and answers pre-sale objections.",what_to_write:"6 questions buyers actually ask: timeline, price, process, revisions, ownership, support."}]}])}]);