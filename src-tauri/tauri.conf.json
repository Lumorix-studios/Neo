{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ProjectNeo",
  "version": "1.11.0",
  "identifier": "com.lumorixstudios.agenticcoder",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Neo",
        "width": 1000,
        "height": 800,
        "minWidth": 660,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "label": "main",
        "decorations": false,
        "backgroundColor": "#0e0e0e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["agenticcoder"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFMDZFRjY2NDBBODI1NDIKUldSQ0phaEFadThHTGl3clhzRFd3Y0UveDVmOGNnemV1UGp0cFRGVjliN01EOGJ1YjlscVo5ZG0K",
      "endpoints": [
        "https://github.com/Lumorix-studios/Neo/releases/latest/download/latest.json"
      ]
    }
  }
}
