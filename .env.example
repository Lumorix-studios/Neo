# Supabase — copy this file to `.env` (git-ignored) and fill in your project values.
# Dashboard → Project Settings → API.
# The app runs fully local when these are empty.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Deep link the OS browser redirects back to after GitHub/Google OAuth and
# password-recovery emails. Must match Supabase Dashboard → Auth → URL
# Configuration → Redirect URLs (add `agenticcoder://auth/callback` there).
VITE_OAUTH_REDIRECT_URL=agenticcoder://auth/callback
